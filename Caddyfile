# Service du site statique sur Railway.
# Railway fournit le port via $PORT ; 80 en secours pour un run local.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:80} {
	root * /srv
	encode zstd gzip
	file_server

	# Application à routage par hash : toute URL inconnue retombe sur index.html.
	try_files {path} {path}/ /index.html

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Tout est revalidé : cinq fichiers, l'ETag renvoie un 304 quand rien n'a
	# bougé. Un max-age sur /assets/* laissait l'atelier sur une version périmée
	# pendant une heure après un correctif — inacceptable pour un poste unique.
	header /index.html Cache-Control "no-cache"
	header /assets/* Cache-Control "no-cache"

	log {
		output stdout
		format console
	}
}
