# Service du site statique sur Railway.
# Railway fournit le port via $PORT ; 80 en secours pour un run local.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:80} {
	root * /srv
	encode zstd gzip
	file_server

	# Application à routage par hash : toute URL inconnue retombe sur index.html.
	try_files {path} {path}/ /index.html

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		-Server

		# Sans matcher : s'applique à « / », aux replis try_files et aux cinq
		# fichiers. Une règle par chemin ne couvrait pas « / » — l'URL que
		# l'atelier utilise justement — qui repartait donc sans consigne de
		# cache, libre au navigateur de garder une version périmée après un
		# correctif. Tout est revalidé, l'ETag renvoie 304 si rien n'a bougé.
		Cache-Control "no-cache"
	}

	log {
		output stdout
		format console
	}
}
